import java.util.*;

class Solution {
    static ArrayList<Integer> subarraySum(int[] arr, int target) {
        
        int n = arr.length, j = 0, sum = 0;

        for(int i = 0; i < n; i++){
            sum += arr[i];

            while(sum > target && j < i){
                sum -= arr[j++];
            }

            if(sum == target){
                ArrayList<Integer> res = new ArrayList<>();
                res.add(j + 1);
                res.add(i + 1);
                return res;
            }
        }

        ArrayList<Integer> res = new ArrayList<>();
        res.add(-1);
        return res;
    }
}
