import java.util.Arrays;

class Solution {
    int missingNum(int arr[]) {

        int arr1[] = new int[arr.length];
        int result = arr.length + 1;   

        for (int i = 0; i < arr1.length; i++) {
            arr1[i] = i + 1;
        }

        Arrays.sort(arr);

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] != arr1[i]) {
                result = arr1[i];
                break;
            }
        }

        return result;
    }
}
